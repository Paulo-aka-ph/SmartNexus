CREATE DATABASE SmartNexus;
USE SmartNexua;

-- Tabela de Usuários
CREATE TABLE usuario (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    telefone VARCHAR(20),
    foto_perfil VARCHAR(255),
    data_cadastro DATE NOT NULL
);

-- Tabela de Portfólio
CREATE TABLE portfolio (
    id_portfolio INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    titulo VARCHAR(150) NOT NULL,
    descricao TEXT NOT NULL,
    categoria VARCHAR(80) NOT NULL,
    imagem VARCHAR(255),
    data_publicacao DATE NOT NULL,

    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario)
        ON DELETE CASCADE
);

-- Tabela de Contato
CREATE TABLE contato (
    id_contato INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL,
    assunto VARCHAR(100) NOT NULL,
    mensagem TEXT NOT NULL,
    data_envio DATE NOT NULL
);

-- Tabela de Feedback
CREATE TABLE feedback (
    id_feedback INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    avaliacao TINYINT NOT NULL,
    comentario TEXT,
    data_feedback DATE NOT NULL,

    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario)
        ON DELETE CASCADE
);

-- Configurações da Conta
CREATE TABLE configuracao (
    id_config INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    idioma VARCHAR(30),
    tema VARCHAR(20),
    notificacoes BOOLEAN DEFAULT TRUE,

    FOREIGN KEY (id_usuario)
        REFERENCES usuario(id_usuario)
        ON DELETE CASCADE
);

-- Ajuda / Suporte
CREATE TABLE suporte (
    id_suporte INT AUTO_INCREMENT PRIMARY KEY,
    pergunta TEXT NOT NULL,
    resposta TEXT,
    data_abertura DATE NOT NULL
);

-- Políticas de Privacidade
CREATE TABLE politica_privacidade (
    id_politica INT AUTO_INCREMENT PRIMARY KEY,
    conteudo TEXT NOT NULL,
    data_atualizacao DATE NOT NULL
);
